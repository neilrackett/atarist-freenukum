# Cross-compile FreeNukum for Atari ST/MiNT with m68k-atari-mint-gcc.
# Output goes to dist/, which doubles as a Hatari GEMDOS drive when
# the game data is extracted to dist/NUKUM/DATA/.
#
# Needs libstdl.a from the STDL repository (default ../atarist-stdl).
# The toolkit container only mounts the folder it is started in, so
# run it from the parent of both checkouts:
#
#   ST_WORKING_FOLDER=$(cd .. && pwd) \
#     stcmd make -C atarist-freenukum -f Makefile.atari

CROSS   = m68k-atari-mint-
CC      = $(CROSS)gcc
STRIP   = $(CROSS)strip

# STDL (Atari ST DirectMedia Layer) instead of the real SDL: its
# compat SDL.h shadows the system one via include order.
STDL   ?= ../atarist-stdl

CFLAGS  = -O2 -fomit-frame-pointer -std=gnu99 -Wall \
          -DHAVE_CONFIG_H -DFN_ATARI_PROFILE \
          -Iatari -I$(STDL)/include -I$(STDL)/include/compat -Isrc
LDLIBS  = $(STDL)/libstdl.a -lm

# GEMDOS 8.3 filename
TARGET  = dist/NUKUM.TOS

# the loading splash is a Degas picture read at startup
SPLASH  = dist/SPLASH.PI1

SRCS    = $(filter-out src/fn_test_%.c,$(wildcard src/fn_*.c)) \
          src/freenukum.c atari/sound.c
OBJS    = $(SRCS:.c=.o)

all: $(TARGET) $(SPLASH)

# dist/ is the build output and a Hatari GEMDOS drive; it is not
# tracked, so a fresh clone has to create it before the link.
dist:
	@mkdir -p $@

$(TARGET): $(OBJS) $(STDL)/libstdl.a | dist
	$(CC) -o $@ $(OBJS) $(LDLIBS)
	$(STRIP) $@

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

$(SPLASH): atari/assets/SPLASH.PI1 | dist
	cp $< $@

clean:
	rm -f $(OBJS) $(TARGET) $(SPLASH)

# Run the latest build in Hatari. This target runs on the host
# (not through stcmd):  make -f Makefile.atari run
run:
	@test -f $(TARGET) || { \
	  echo "$(TARGET) not found - build first: stcmd make -f Makefile.atari"; \
	  exit 1; }
	hatari --memsize 4 --fast-boot on $(TARGET)

.PHONY: all clean run
