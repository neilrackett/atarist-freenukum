# Cross-compile FreeNukum for Atari ST/MiNT with m68k-atari-mint-gcc.
# Output goes to dist/, which doubles as a Hatari GEMDOS drive when
# the game data is extracted to dist/NUKUM/DATA/.
# Run inside the toolkit container:  stcmd make -f Makefile.atari
# or from the host with the stcmd wrapper doing the mounting.

CROSS   = m68k-atari-mint-
CC      = $(CROSS)gcc
STRIP   = $(CROSS)strip

# Native SDL-subset shim (atari/nsdl) instead of the real SDL:
# its SDL.h shadows the system one via include order.
CFLAGS  = -O2 -fomit-frame-pointer -std=gnu99 -Wall \
          -DHAVE_CONFIG_H -Iatari -Iatari/nsdl -Isrc
LDLIBS  = -lm

# GEMDOS 8.3 filename
TARGET  = dist/NUKUM.TOS

SRCS    = $(filter-out src/fn_test_%.c,$(wildcard src/fn_*.c)) \
          src/freenukum.c atari/nsdl/nsdl.c atari/nsdl/sound.c atari/nsdl/splash.c
OBJS    = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) -o $@ $(OBJS) $(LDLIBS)
	$(STRIP) $@

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all clean
