# Cross-compile FreeNukum for Atari ST/MiNT with m68k-atari-mint-gcc.
# Output goes to dist/, which doubles as a Hatari GEMDOS drive when
# the game data is extracted to dist/NUKUM/DATA/.
#
#   STCMD_NO_TTY=1 stcmd make -f Makefile.atari
#
# stcmd mounts the current directory into the toolkit container and
# runs there, so everything the build touches has to live inside this
# repository. STDL does: lib/stdl is a submodule, and the library
# is built from it automatically when libstdl.a is missing.
#
#   git clone --recurse-submodules <url>     # fresh clone
#   git submodule update --init              # existing clone

CROSS   = m68k-atari-mint-
CC      = $(CROSS)gcc
STRIP   = $(CROSS)strip

# STDL (Atari ST DirectMedia Layer) instead of the real SDL: its
# compat SDL.h shadows the system one via include order.
#
# The submodule wins when it is present; a sibling checkout is the
# fallback, so the library and a game can still be worked on
# together. Override with STDL=<path>.
STDL     ?= $(firstword $(wildcard lib/stdl) ../atarist-stdl)
STDL_LIB  = $(STDL)/libstdl.a

# Cloning without --recurse-submodules leaves lib/stdl an empty
# directory; say so rather than failing on a missing SDL.h.
ifeq ($(wildcard $(STDL)/include),)
ifeq ($(filter clean run,$(MAKECMDGOALS)),)
$(error STDL not found in $(STDL) - run: git submodule update --init)
endif
endif

# EXTRA_CFLAGS is a hook for one-off diagnostic builds, e.g.
#   stcmd make -f Makefile.atari EXTRA_CFLAGS=-DFN_HEAP_DEBUG
# (stcmd word-splits its arguments, so keep the value space-free).
CFLAGS  = -O2 -fomit-frame-pointer -std=gnu99 -Wall \
          -DHAVE_CONFIG_H -DFN_ATARI_PROFILE \
          -Iatari -I$(STDL)/include -I$(STDL)/include/compat -Isrc \
          $(EXTRA_CFLAGS)
LDLIBS  = $(STDL_LIB) -lm

# GEMDOS 8.3 filename
TARGET  = dist/NUKUM.TOS

SRCS    = $(filter-out src/fn_test_%.c,$(wildcard src/fn_*.c)) \
          src/freenukum.c atari/sound.c
OBJS    = $(SRCS:.c=.o)

all: $(TARGET)

# dist/ is the build output and a Hatari GEMDOS drive; it is not
# tracked, so a fresh clone has to create it before the link.
dist:
	@mkdir -p $@

# The loading splash rides along appended to the executable: GEMDOS
# loads only the segments named in the program header, so the
# picture stays on disk (STDL_ShowDegasTrailer reads it from there)
# and costs no RAM.
$(TARGET): $(OBJS) $(STDL_LIB) atari/assets/SPLASH.PI1 | dist
	$(CC) -o $@ $(OBJS) $(LDLIBS)
	$(STRIP) $@
	cat atari/assets/SPLASH.PI1 >> $@

# Build the library from the submodule when its archive is missing, so
# a fresh clone needs one command, and rebuild it when its sources have
# moved. The archive used to have no prerequisites at all, which meant a
# submodule bump silently kept linking the old library: the binary came
# out byte identical and nothing said why.
#
# Both source directories are listed. STDL's own xpad consumer lives in
# its lib/xpad submodule rather than under src/, so a pattern that only
# watched src/ would miss exactly the file a bump is most likely to
# change.
STDL_SRCS = $(wildcard $(STDL)/src/*.c) $(wildcard $(STDL)/src/*.h) \
            $(wildcard $(STDL)/lib/xpad/src/*.c) \
            $(wildcard $(STDL)/lib/xpad/src/*.h)

$(STDL_LIB): $(STDL_SRCS)
	$(MAKE) -C $(STDL) libstdl.a

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(TARGET) dist/SPLASH.PI1

# Run the latest build in Hatari. This target runs on the host
# (not through stcmd):  make -f Makefile.atari run
run:
	@test -f $(TARGET) || { \
	  echo "$(TARGET) not found - build first: stcmd make -f Makefile.atari"; \
	  exit 1; }
	hatari --memsize 4 --fast-boot on $(TARGET)

.PHONY: all clean run
