# Cross-compile FreeNukum for Atari ST/MiNT with m68k-atari-mint-gcc.
# Output goes to dist/, which doubles as a Hatari GEMDOS drive when
# the game data is extracted to dist/NUKUM/DATA/.
# Run inside the toolkit container:  stcmd make -f Makefile.atari
# or from the host with the stcmd wrapper doing the mounting.

CROSS   = m68k-atari-mint-
CC      = $(CROSS)gcc
STRIP   = $(CROSS)strip

# Native SDL-subset shim (atari/nsdl) instead of the real SDL:
# its SDL.h shadows the system one via include order.
CFLAGS  = -O2 -fomit-frame-pointer -std=gnu99 -Wall \
          -DHAVE_CONFIG_H -Iatari -Iatari/nsdl -Isrc
LDLIBS  = -lm

# GEMDOS 8.3 filename
TARGET  = dist/NUKUM.TOS

SRCS    = $(filter-out src/fn_test_%.c,$(wildcard src/fn_*.c)) \
          src/freenukum.c atari/nsdl/nsdl.c atari/nsdl/sound.c atari/nsdl/splash.c
OBJS    = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) -o $@ $(OBJS) $(LDLIBS)
	$(STRIP) $@

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

# the splash screen is embedded from the Degas picture; replace
# atari/assets/SPLASH.PI1 and rebuild to update it
atari/nsdl/splash.c: atari/assets/SPLASH.PI1 atari/mksplash.sh
	sh atari/mksplash.sh atari/assets/SPLASH.PI1 $@

clean:
	rm -f $(OBJS) $(TARGET)

# Run the latest build in Hatari. This target runs on the host
# (not through stcmd):  make -f Makefile.atari run
HATARI  ?= /Applications/Hatari.app/Contents/MacOS/hatari
TOSROM  ?= /Users/neil/Library/CloudStorage/Dropbox/Atari ST/SidecarTridge/TOS Emulator/TOS Images/TOS 2.06 - UK - Original.img

run:
	@test -f $(TARGET) || { \
	  echo "$(TARGET) not found - build first: stcmd make -f Makefile.atari"; \
	  exit 1; }
	"$(HATARI)" --memsize 4 --fast-boot on --tos "$(TOSROM)" $(TARGET)

.PHONY: all clean run
